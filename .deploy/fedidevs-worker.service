[Unit]
Description=Fedidevs Worker
After=fedidevs.service

[Service]
Type=simple
Restart=always
RestartSec=1
ExecStart=/bin/bash /var/apps/fedidevs/.deploy/run_worker.sh
ExecReload=/bin/kill -HUP $MAINPID
# Send SIGTERM to the supervisor only, and let it stop its processes.
KillMode=mixed
TimeoutStopSec=35
User=anze

[Install]
WantedBy=fedidevs.service
